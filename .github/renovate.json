{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly",
    "group:allNonMajor"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "matchPackageNames": ["playwright-core"],
      "groupName": "playwright-core"
    },
    {
      "matchPackageNames": ["mediabunny"],
      "groupName": "mediabunny"
    }
  ]
}
